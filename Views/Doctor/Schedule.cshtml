@model IEnumerable<randevu_kayit.Models.DoctorSchedule>
@{
    ViewData["Title"] = "Çalışma Saatleri";
}

<div class="container-fluid py-4">
    <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="col-auto">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary active" data-view="daily">
                            <i class="bi bi-calendar-day"></i> Günlük
                        </button>
                        <button type="button" class="btn btn-outline-primary" data-view="weekly">
                            <i class="bi bi-calendar-week"></i> Haftalık
                        </button>
                        <button type="button" class="btn btn-outline-primary" data-view="monthly">
                            <i class="bi bi-calendar-month"></i> Aylık
                        </button>
                    </div>
                    <button type="button" class="btn btn-primary ms-2" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
                        <i class="bi bi-plus-circle me-2"></i>Yeni Program Ekle
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Calendar Views -->
            <div id="calendarViews">
                <!-- Daily View -->
                <div id="dailyView" class="view-section">
                    <div class="table-responsive">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th>Tarih</th>
                                    <th>Başlangıç</th>
                                    <th>Bitiş</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in Model)
                                {
                                    <tr>
                                        <td>@schedule.Tarih.ToString("dd.MM.yyyy")</td>
                                        <td>@schedule.BaslangicSaat.ToString(@"hh\:mm")</td>
                                        <td>@schedule.BitisSaat.ToString(@"hh\:mm")</td>
                                        <td>
                                            <span class="badge bg-@(schedule.IsActive ? "success" : "danger")">
                                                @(schedule.IsActive ? "Aktif" : "Pasif")
                                            </span>
                                        </td>
                                        <td>
                                            <form asp-action="DeleteSchedule" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@schedule.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" 
                                                        onclick="return confirm('Bu programı silmek istediğinizden emin misiniz?')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Weekly View -->
                <div id="weeklyView" class="view-section" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button class="btn btn-sm btn-outline-secondary" id="prevWeek">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <h6 class="mb-0" id="weekRange"></h6>
                        <button class="btn btn-sm btn-outline-secondary" id="nextWeek">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Saat</th>
                                    <th>Pazartesi</th>
                                    <th>Salı</th>
                                    <th>Çarşamba</th>
                                    <th>Perşembe</th>
                                    <th>Cuma</th>
                                    <th>Cumartesi</th>
                                    <th>Pazar</th>
                                </tr>
                            </thead>
                            <tbody id="weeklySchedule">
                                <!-- JavaScript ile doldurulacak -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Monthly View -->
                <div id="monthlyView" class="view-section" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button class="btn btn-sm btn-outline-secondary" id="prevMonth">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <h6 class="mb-0" id="currentMonth"></h6>
                        <button class="btn btn-sm btn-outline-secondary" id="nextMonth">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Pzt</th>
                                    <th>Sal</th>
                                    <th>Çar</th>
                                    <th>Per</th>
                                    <th>Cum</th>
                                    <th>Cmt</th>
                                    <th>Paz</th>
                                </tr>
                            </thead>
                            <tbody id="monthlySchedule">
                                <!-- JavaScript ile doldurulacak -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Schedule Modal -->
<div class="modal fade" id="addScheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddSchedule" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Program Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Program Tipi</label>
                        <select class="form-select" name="scheduleType" id="scheduleType">
                            <option value="daily">Günlük</option>
                            <option value="weekly">Haftalık</option>
                            <option value="monthly">Aylık</option>
                        </select>
                    </div>
                    <div id="dailyScheduleForm">
                        <div class="mb-3">
                            <label class="form-label">Tarih</label>
                            <input type="date" name="tarih" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Başlangıç Saati</label>
                            <input type="time" name="baslangicSaat" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Bitiş Saati</label>
                            <input type="time" name="bitisSaat" class="form-control" required>
                        </div>
                    </div>
                    <div id="weeklyScheduleForm" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label">Başlangıç Tarihi</label>
                            <input type="date" name="weeklyStartDate" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Bitiş Tarihi</label>
                            <input type="date" name="weeklyEndDate" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Çalışma Günleri</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDays" value="1" id="monday">
                                <label class="form-check-label" for="monday">Pazartesi</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDays" value="2" id="tuesday">
                                <label class="form-check-label" for="tuesday">Salı</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDays" value="3" id="wednesday">
                                <label class="form-check-label" for="wednesday">Çarşamba</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDays" value="4" id="thursday">
                                <label class="form-check-label" for="thursday">Perşembe</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDays" value="5" id="friday">
                                <label class="form-check-label" for="friday">Cuma</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDays" value="6" id="saturday">
                                <label class="form-check-label" for="saturday">Cumartesi</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="workDays" value="0" id="sunday">
                                <label class="form-check-label" for="sunday">Pazar</label>
                            </div>
                        </div>
                    </div>
                    <div id="monthlyScheduleForm" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label">Ay</label>
                            <input type="month" name="month" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Çalışma Günleri</label>
                            <div id="monthDays" class="d-flex flex-wrap gap-2">
                                <!-- JavaScript ile doldurulacak -->
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table > :not(caption) > * > * {
            padding: 1rem 1rem;
        }
        
        .btn-group .btn {
            margin: 0 2px;
        }
        
        .badge {
            font-size: 0.875em;
        }

        .calendar-cell {
            height: 100px;
            vertical-align: top;
            padding: 5px !important;
        }

        .calendar-cell .date {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .calendar-cell .schedule {
            font-size: 0.8em;
            color: #666;
        }

        .calendar-cell.today {
            background-color: #e8f4ff;
        }

        .calendar-cell.has-schedule {
            background-color: #e8ffe8;
        }

        .calendar-cell.other-month {
            background-color: #f5f5f5;
            color: #999;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // View switching
            $('[data-view]').click(function() {
                const view = $(this).data('view');
                $('.view-section').hide();
                $(`#${view}View`).show();
                $('[data-view]').removeClass('active');
                $(this).addClass('active');

                if (view === 'weekly') {
                    initializeWeeklyView();
                } else if (view === 'monthly') {
                    initializeMonthlyView();
                }
            });

            // Schedule type switching
            $('#scheduleType').change(function() {
                const type = $(this).val();
                $('#dailyScheduleForm, #weeklyScheduleForm, #monthlyScheduleForm').hide();
                $(`#${type}ScheduleForm`).show();
            });

            // Initialize views
            let currentDate = new Date();

            function initializeWeeklyView() {
                updateWeekRange(currentDate);
                loadWeeklySchedule(currentDate);
            }

            function initializeMonthlyView() {
                updateMonthDisplay(currentDate);
                loadMonthlySchedule(currentDate);
            }

            function updateWeekRange(date) {
                const start = new Date(date);
                start.setDate(start.getDate() - start.getDay() + 1);
                const end = new Date(start);
                end.setDate(end.getDate() + 6);
                $('#weekRange').text(
                    `${start.toLocaleDateString('tr-TR')} - ${end.toLocaleDateString('tr-TR')}`
                );
            }

            function updateMonthDisplay(date) {
                $('#currentMonth').text(
                    date.toLocaleDateString('tr-TR', { year: 'numeric', month: 'long' })
                );
            }

            function loadWeeklySchedule(date) {
                // AJAX call to get weekly schedule
                // This will be implemented in the backend
            }

            function loadMonthlySchedule(date) {
                // AJAX call to get monthly schedule
                // This will be implemented in the backend
            }

            // Navigation handlers
            $('#prevWeek').click(function() {
                currentDate.setDate(currentDate.getDate() - 7);
                initializeWeeklyView();
            });

            $('#nextWeek').click(function() {
                currentDate.setDate(currentDate.getDate() + 7);
                initializeWeeklyView();
            });

            $('#prevMonth').click(function() {
                currentDate.setMonth(currentDate.getMonth() - 1);
                initializeMonthlyView();
            });

            $('#nextMonth').click(function() {
                currentDate.setMonth(currentDate.getMonth() + 1);
                initializeMonthlyView();
            });
        });
    </script>
} 