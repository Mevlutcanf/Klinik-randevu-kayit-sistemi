@using randevu_kayit.Models
@model IEnumerable<MedicalHistory>

@{
    ViewData["Title"] = "Hasta Geçmişi";
    var patient = ViewBag.Patient as ApplicationUser;
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h4 class="card-title">
                        <i class="bi bi-person-lines-fill me-2"></i>
                        @patient.AdSoyad - Hasta Geçmişi
                    </h4>
                    <div class="row mt-3">
                        <div class="col-md-4">
                            <p><strong>TC Kimlik No:</strong> @patient.TCKimlikNo</p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Doğum Tarihi:</strong> @patient.DogumTarihi?.ToString("dd.MM.yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Kan Grubu:</strong> @patient.KanGrubu</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <p><strong>Kronik Hastalıklar:</strong> @patient.KronikHastaliklar</p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Alerjiler:</strong> @patient.Alerjiler</p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Kullanılan İlaçlar:</strong> @patient.KullanilanIlaclar</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Bu hasta için henüz kayıtlı bir muayene geçmişi bulunmamaktadır.
                </div>
            }
            else
            {
                <div class="timeline">
                    @foreach (var history in Model)
                    {
                        <div class="timeline-item">
                            <div class="card shadow-sm">
                                <div class="card-header bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <i class="bi bi-calendar-event me-2"></i>
                                            @history.TarihSaat.ToString("dd.MM.yyyy HH:mm")
                                        </h5>
                                        @if (history.SonrakiRandevuTarihi.HasValue)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-calendar-check me-1"></i>
                                                Sonraki Randevu: @history.SonrakiRandevuTarihi.Value.ToString("dd.MM.yyyy")
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <h6><i class="bi bi-clipboard2-pulse me-2"></i>Tanı</h6>
                                            <p>@history.Tani</p>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(history.Tedavi))
                                    {
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-bandaid me-2"></i>Tedavi</h6>
                                                <p>@history.Tedavi</p>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(history.YazilanIlaclar))
                                    {
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-capsule me-2"></i>Yazılan İlaçlar</h6>
                                                <p>@history.YazilanIlaclar</p>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(history.LabSonuclari))
                                    {
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-file-earmark-medical me-2"></i>Laboratuvar Sonuçları</h6>
                                                <p>@history.LabSonuclari</p>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(history.Notlar))
                                    {
                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-journal-text me-2"></i>Notlar</h6>
                                                <p>@history.Notlar</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div> 