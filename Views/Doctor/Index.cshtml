@model IEnumerable<randevu_kayit.Models.Randevu>
@{
    ViewData["Title"] = "Doktor Paneli";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card">
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-8">
                            <div class="numbers">
                                <p class="text-sm mb-0 text-uppercase font-weight-bold">Bugünkü Randevular</p>
                                <h5 class="font-weight-bolder">@ViewBag.TodaysAppointmentCount</h5>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div class="icon icon-shape bg-gradient-primary shadow-primary text-center rounded-circle">
                                <i class="bi bi-calendar-check opacity-10"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card">
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-8">
                            <div class="numbers">
                                <p class="text-sm mb-0 text-uppercase font-weight-bold">Toplam Randevu</p>
                                <h5 class="font-weight-bolder">@ViewBag.TotalAppointments</h5>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div class="icon icon-shape bg-gradient-success shadow-success text-center rounded-circle">
                                <i class="bi bi-clipboard-data opacity-10"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6 mb-4">
            <div class="card">
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-8">
                            <div class="numbers">
                                <p class="text-sm mb-0 text-uppercase font-weight-bold">Toplam Hasta</p>
                                <h5 class="font-weight-bolder">@ViewBag.UniquePatients</h5>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div class="icon icon-shape bg-gradient-warning shadow-warning text-center rounded-circle">
                                <i class="bi bi-people opacity-10"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header pb-0">
                    <div class="d-flex justify-content-between">
                        <h6>Bugünkü Randevular</h6>
                        <a asp-action="Schedule" class="btn btn-sm btn-primary">
                            <i class="bi bi-calendar-week me-2"></i>Çalışma Saatlerini Düzenle
                        </a>
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2">
                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th>Saat</th>
                                    <th>Hasta</th>
                                    <th>Şikayet</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    foreach (var appointment in Model)
                                    {
                                        <tr>
                                            <td>@appointment.RandevuTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@(appointment.Hasta?.AdSoyad ?? "Hasta bilgisi yok")</td>
                                            <td>@(appointment.Sikayet ?? "-")</td>
                                            <td>
                                                <span class="badge bg-@(appointment.Durum == RandevuDurumu.Aktif ? "success" : 
                                                             appointment.Durum == RandevuDurumu.Tamamlandi ? "info" : "secondary")">
                                                    @appointment.Durum
                                                </span>
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-info" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#noteModal" 
                                                        data-appointment-id="@appointment.Id"
                                                        data-current-note="@appointment.DoktorNotu">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Note Modal -->
<div class="modal fade" id="noteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddNote" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Randevu Notu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="appointmentId" id="appointmentId">
                    <div class="form-floating">
                        <textarea class="form-control" name="note" id="note" style="height: 100px"></textarea>
                        <label for="note">Not</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .icon-shape {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .bg-gradient-primary {
            background: linear-gradient(45deg, #5e72e4, #825ee4);
        }
        
        .bg-gradient-success {
            background: linear-gradient(45deg, #2dce89, #2dcecc);
        }
        
        .bg-gradient-warning {
            background: linear-gradient(45deg, #fb6340, #fbb140);
        }
        
        .icon i {
            font-size: 1.5rem;
            color: white;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#noteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var appointmentId = button.data('appointment-id');
                var currentNote = button.data('current-note');
                
                var modal = $(this);
                modal.find('#appointmentId').val(appointmentId);
                modal.find('#note').val(currentNote);
            });
        });
    </script>
}
