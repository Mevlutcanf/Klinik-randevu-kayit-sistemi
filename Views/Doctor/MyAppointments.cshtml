@model IEnumerable<randevu_kayit.Models.Appointment>

<h2>Randevularım</h2>

<table class="table">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Hasta</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.Patient?.FullName ?? "Hasta bilgisi yok")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="AppointmentDetails" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a>
                </td>
            </tr>
        }
    </tbody>
</table>
