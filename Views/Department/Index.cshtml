@model IEnumerable<randevu_kayit.Models.Department>
@{
    ViewData["Title"] = "Bölümlerimiz";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h2 class="text-center mb-5">@ViewData["Title"]</h2>
            <div class="row g-4">
                @foreach (var department in Model)
                {
                    <div class="col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm">
                            <div class="department-image-container">
                                @if (!string.IsNullOrEmpty(department.ImageUrl))
                                {
                                    <img src="@department.ImageUrl" class="card-img-top department-image" alt="@department.Name">
                                }
                                else
                                {
                                    <img src="~/img/departments/default.svg" class="card-img-top department-image" alt="@department.Name">
                                }
                            </div>
                            <div class="card-body text-center">
                                <h5 class="card-title">@department.Name</h5>
                                @if (!string.IsNullOrEmpty(department.Description))
                                {
                                    <p class="card-text text-muted small">@department.Description</p>
                                }
                                <div class="mt-3">
                                    <span class="badge bg-info">
                                        <i class="bi bi-people-fill me-1"></i>
                                        @department.Doctors.Count Doktor
                                    </span>
                                </div>
                                @if (User.Identity?.IsAuthenticated ?? false)
                                {
                                    <div class="mt-3">
                                        <a asp-controller="Randevu" asp-action="Create" 
                                           asp-route-bolum="@department.Name" 
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-calendar-plus me-1"></i>
                                            Randevu Al
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease-in-out;
            border: none;
            border-radius: 10px;
            overflow: hidden;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .badge {
            font-weight: normal;
        }
        .department-image-container {
            position: relative;
            padding-top: 66.67%; /* 3:2 aspect ratio */
            overflow: hidden;
        }
        .department-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .card:hover .department-image {
            transform: scale(1.1);
        }
        @@media (max-width: 768px) {
            .department-image-container {
                padding-top: 75%; /* 4:3 aspect ratio for mobile */
            }
        }
    </style>
} 