@model ApplicationUser
@{
    ViewData["Title"] = "Kullanıcı Detayları";
}

<link href="~/css/admin-modern.css" rel="stylesheet" />

<div class="admin-container">
    <div class="admin-header">
        <div class="admin-header-content">
            <div class="admin-header-left">
                <div class="admin-header-icon bg-gradient-blue">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div>
                    <h1 class="admin-header-title">@Model.AdSoyad</h1>
                    <p class="admin-header-subtitle">Kullanıcı detay bilgileri ve aktivite özeti</p>
                </div>
            </div>
            <div class="admin-header-actions">
                <a asp-action="Users" class="modern-btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    <span>Kullanıcı Listesi</span>
                </a>
            </div>
        </div>
    </div>

    <div class="admin-content">
        <div class="user-profile-layout">
            <!-- Kullanıcı Profil Kartı -->
            <div class="user-profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-title">
                        <i class="bi bi-person-badge text-primary"></i>
                        Profil Bilgileri
                    </div>
                    <div class="profile-card-actions">
                        <button class="modern-btn-icon btn-primary" title="Düzenle">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </div>
                </div>
                
                <div class="profile-card-content">
                    <div class="user-avatar-section">
                        <div class="user-avatar-wrapper">
                            <img src="@(Model.ProfilePhotoPath ?? "/images/default-user.png")" 
                                 alt="Profil Fotoğrafı" 
                                 class="user-avatar-large">
                            <div class="user-status-indicator online"></div>
                        </div>
                        
                        <div class="user-basic-info">
                            <h3 class="user-name">@Model.AdSoyad</h3>
                            <div class="user-roles">
                                @if (ViewBag.UserRoles != null && ((List<string>)ViewBag.UserRoles).Any())
                                {
                                    foreach (var role in (List<string>)ViewBag.UserRoles)
                                    {
                                        <span class="modern-badge @(role == "Admin" ? "badge-danger" : role == "Doctor" ? "badge-success" : "badge-primary")">@role</span>
                                    }
                                }
                            </div>
                            
                            @if (Model.Department != null)
                            {
                                <div class="user-department">
                                    <i class="bi bi-building"></i>
                                    <span>@Model.Department.Name</span>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.Uzmanlik))
                            {
                                <div class="user-specialty">
                                    <i class="bi bi-award"></i>
                                    <span>@Model.Uzmanlik</span>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="profile-divider"></div>
                    
                    <!-- İletişim Bilgileri -->
                    <div class="profile-info-list">
                        <div class="profile-info-item">
                            <span class="info-label">
                                <i class="bi bi-envelope"></i>
                                Email
                            </span>
                            <span class="info-value">@Model.Email</span>
                        </div>
                        <div class="profile-info-item">
                            <span class="info-label">
                                <i class="bi bi-telephone"></i>
                                Telefon
                            </span>
                            <span class="info-value">@(Model.PhoneNumber ?? "Belirtilmemiş")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.TCKimlikNo))
                        {
                            <div class="profile-info-item">
                                <span class="info-label">
                                    <i class="bi bi-credit-card-2-front"></i>
                                    TC Kimlik
                                </span>
                                <span class="info-value">@Model.TCKimlikNo</span>
                            </div>
                        }
                        @if (Model.DogumTarihi.HasValue)
                        {
                            <div class="profile-info-item">
                                <span class="info-label">
                                    <i class="bi bi-calendar-heart"></i>
                                    Doğum Tarihi
                                </span>
                                <span class="info-value">@Model.DogumTarihi.Value.ToString("dd.MM.yyyy")</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Cinsiyet))
                        {
                            <div class="profile-info-item">
                                <span class="info-label">
                                    <i class="bi bi-gender-ambiguous"></i>
                                    Cinsiyet
                                </span>
                                <span class="info-value">@Model.Cinsiyet</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Adres))
                        {
                            <div class="profile-info-item">
                                <span class="info-label">
                                    <i class="bi bi-geo-alt"></i>
                                    Adres
                                </span>
                                <span class="info-value">@Model.Adres</span>
                            </div>
                        }
                    </div>
                </div>
            </div>            
            <!-- İstatistikler ve Detaylar -->
            <div class="user-details-section">
                <!-- İstatistik Kartları -->
                @if (ViewBag.UserRoles != null && ((List<string>)ViewBag.UserRoles).Contains("Doctor"))
                {
                    <div class="stats-grid">
                        <div class="stats-card bg-gradient-blue">
                            <div class="stats-card-icon">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <div class="stats-card-content">
                                <div class="stats-card-number">@ViewBag.TotalAppointments</div>
                                <div class="stats-card-label">Toplam Randevu</div>
                            </div>
                        </div>
                        
                        <div class="stats-card bg-gradient-green">
                            <div class="stats-card-icon">
                                <i class="bi bi-check-circle"></i>
                            </div>
                            <div class="stats-card-content">
                                <div class="stats-card-number">@ViewBag.CompletedAppointments</div>
                                <div class="stats-card-label">Tamamlanan</div>
                            </div>
                        </div>
                    </div>
                }
                else if (ViewBag.UserRoles != null && ((List<string>)ViewBag.UserRoles).Contains("Patient"))
                {
                    <div class="stats-grid">
                        <div class="stats-card bg-gradient-blue">
                            <div class="stats-card-icon">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <div class="stats-card-content">
                                <div class="stats-card-number">@ViewBag.TotalAppointments</div>
                                <div class="stats-card-label">Toplam Randevu</div>
                            </div>
                        </div>
                        
                        <div class="stats-card bg-gradient-purple">
                            <div class="stats-card-icon">
                                <i class="bi bi-clock"></i>
                            </div>
                            <div class="stats-card-content">
                                <div class="stats-card-number">@ViewBag.UpcomingAppointments</div>
                                <div class="stats-card-label">Yaklaşan</div>
                            </div>
                        </div>
                    </div>
                }                
                <!-- Doktor Ek Bilgileri -->
                @if (ViewBag.UserRoles != null && ((List<string>)ViewBag.UserRoles).Contains("Doctor"))
                {
                    <div class="detail-card doctor-info-card">
                        <div class="detail-card-header">
                            <div class="detail-card-icon bg-gradient-blue">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <h4 class="detail-card-title">Doktor Bilgileri</h4>
                        </div>
                        <div class="detail-card-content">
                            <div class="info-grid">
                                @if (!string.IsNullOrEmpty(Model.About))
                                {
                                    <div class="info-item-full">
                                        <span class="info-label">
                                            <i class="bi bi-file-text"></i>
                                            Hakkında
                                        </span>
                                        <p class="info-description">@Model.About</p>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.CalismaSaatleri))
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-clock"></i>
                                            Çalışma Saatleri
                                        </span>
                                        <span class="info-value">@Model.CalismaSaatleri</span>
                                    </div>
                                }
                                
                                @if (Model.DeneyimYili.HasValue)
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-award"></i>
                                            Deneyim
                                        </span>
                                        <span class="info-value">@Model.DeneyimYili yıl</span>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.MezunOlduguUniversite))
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-mortarboard"></i>
                                            Üniversite
                                        </span>
                                        <span class="info-value">@Model.MezunOlduguUniversite</span>
                                    </div>
                                }
                                
                                @if (Model.MezuniyetYili.HasValue)
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-calendar-check"></i>
                                            Mezuniyet Yılı
                                        </span>
                                        <span class="info-value">@Model.MezuniyetYili</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }                
                <!-- Hasta Ek Bilgileri -->
                @if (ViewBag.UserRoles != null && ((List<string>)ViewBag.UserRoles).Contains("Patient"))
                {
                    <div class="detail-card health-info-card">
                        <div class="detail-card-header">
                            <div class="detail-card-icon bg-gradient-red">
                                <i class="bi bi-heart-pulse"></i>
                            </div>
                            <h4 class="detail-card-title">Sağlık Bilgileri</h4>
                        </div>
                        <div class="detail-card-content">
                            <div class="info-grid">
                                @if (!string.IsNullOrEmpty(Model.KanGrubu))
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-droplet"></i>
                                            Kan Grubu
                                        </span>
                                        <span class="info-value">
                                            <span class="modern-badge badge-danger">@Model.KanGrubu</span>
                                        </span>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.KronikHastaliklar))
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-clipboard-pulse"></i>
                                            Kronik Hastalıklar
                                        </span>
                                        <span class="info-value">@Model.KronikHastaliklar</span>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.Alerjiler))
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            Alerjiler
                                        </span>
                                        <span class="info-value">@Model.Alerjiler</span>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.KullanilanIlaclar))
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-capsule"></i>
                                            Kullanılan İlaçlar
                                        </span>
                                        <span class="info-value">@Model.KullanilanIlaclar</span>
                                    </div>
                                }
                                
                                @if (Model.Boy.HasValue || Model.Kilo.HasValue)
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-rulers"></i>
                                            Fiziksel Bilgiler
                                        </span>
                                        <span class="info-value">
                                            @if (Model.Boy.HasValue) { <span>Boy: @Model.Boy cm</span> }
                                            @if (Model.Boy.HasValue && Model.Kilo.HasValue) { <span> | </span> }
                                            @if (Model.Kilo.HasValue) { <span>Kilo: @Model.Kilo kg</span> }
                                        </span>
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(Model.AcilDurumKisisi))
                                {
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="bi bi-person-plus"></i>
                                            Acil Durum Kişisi
                                        </span>
                                        <span class="info-value">
                                            <div>@Model.AcilDurumKisisi</div>
                                            @if (!string.IsNullOrEmpty(Model.AcilDurumTelefonu))
                                            {
                                                <div class="info-sub-value">@Model.AcilDurumTelefonu</div>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                
                <!-- İşlem Butonları -->
                <div class="action-buttons-card">
                    <div class="action-buttons-left">
                        <a asp-action="Users" class="modern-btn btn-secondary">
                            <i class="bi bi-arrow-left"></i>
                            <span>Geri Dön</span>
                        </a>
                    </div>
                    <div class="action-buttons-right">
                        <button type="button" class="modern-btn btn-warning">
                            <i class="bi bi-pencil"></i>
                            <span>Düzenle</span>
                        </button>
                        @if (ViewBag.UserRoles != null && !((List<string>)ViewBag.UserRoles).Contains("Admin"))
                        {
                            <button type="button" class="modern-btn btn-danger" onclick="confirmDelete('@Model.Id')">
                                <i class="bi bi-trash"></i>
                                <span>Sil</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // DOM Ready
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize fade-in animations
        const elements = document.querySelectorAll('.fade-in');
        elements.forEach((el, index) => {
            setTimeout(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });

    // Confirm delete function
    function confirmDelete(userId) {
        // Create modern confirmation dialog
        const confirmDialog = document.createElement('div');
        confirmDialog.className = 'modern-modal';
        confirmDialog.innerHTML = `
            <div class="modern-modal-backdrop"></div>
            <div class="modern-modal-content">
                <div class="modern-modal-header bg-gradient-red">
                    <h3 class="modern-modal-title">
                        <i class="bi bi-exclamation-triangle"></i>
                        Kullanıcıyı Sil
                    </h3>
                    <button type="button" class="modern-modal-close" onclick="this.closest('.modern-modal').remove()">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <div class="modern-modal-body">
                    <div class="confirmation-content">
                        <div class="confirmation-icon">
                            <i class="bi bi-person-x text-danger"></i>
                        </div>
                        <p class="confirmation-text">Bu kullanıcıyı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
                    </div>
                </div>
                <div class="modern-modal-footer">
                    <button type="button" class="modern-btn btn-secondary" onclick="this.closest('.modern-modal').remove()">
                        <i class="bi bi-x-circle"></i>
                        <span>İptal</span>
                    </button>
                    <button type="button" class="modern-btn btn-danger" onclick="deleteUser('${userId}')">
                        <i class="bi bi-check-circle"></i>
                        <span>Sil</span>
                    </button>
                </div>
            </div>
        `;
        
        document.body.appendChild(confirmDialog);
        setTimeout(() => confirmDialog.classList.add('show'), 10);
    }

    // Delete user function
    function deleteUser(userId) {
        // AJAX ile silme işlemi
        fetch('@Url.Action("DeleteUser", "Admin")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify({ userId: userId })
        })
        .then(response => response.json())
        .then(data => {
            // Remove modal
            document.querySelector('.modern-modal').remove();
            
            if (data.success) {
                // Success notification
                showSuccessNotification('Başarılı!', 'Kullanıcı başarıyla silindi.');
                setTimeout(() => {
                    window.location.href = '@Url.Action("Users", "Admin")';
                }, 2000);
            } else {
                // Error notification
                showErrorNotification('Hata!', 'Silme işlemi başarısız oldu.');
            }
        })
        .catch(error => {
            document.querySelector('.modern-modal').remove();
            showErrorNotification('Hata!', 'Bir hata oluştu.');
        });
    }

    // Success notification
    function showSuccessNotification(title, message) {
        const notification = document.createElement('div');
        notification.className = 'modern-notification success';
        notification.innerHTML = `
            <div class="notification-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="notification-content">
                <h4>${title}</h4>
                <p>${message}</p>
            </div>
            <button class="notification-close" onclick="this.parentElement.remove()">
                <i class="bi bi-x"></i>
            </button>
        `;
        
        document.body.appendChild(notification);
        setTimeout(() => notification.classList.add('show'), 100);
        setTimeout(() => notification.remove(), 5000);
    }

    // Error notification
    function showErrorNotification(title, message) {
        const notification = document.createElement('div');
        notification.className = 'modern-notification error';
        notification.innerHTML = `
            <div class="notification-icon">
                <i class="bi bi-x-circle"></i>
            </div>
            <div class="notification-content">
                <h4>${title}</h4>
                <p>${message}</p>
            </div>
            <button class="notification-close" onclick="this.parentElement.remove()">
                <i class="bi bi-x"></i>
            </button>
        `;
        
        document.body.appendChild(notification);
        setTimeout(() => notification.classList.add('show'), 100);
        setTimeout(() => notification.remove(), 5000);
    }
</script>
