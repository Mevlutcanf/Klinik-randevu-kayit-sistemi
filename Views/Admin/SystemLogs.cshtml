@section Scripts {
    <script>
        let autoRefreshInterval;
        
        // Modern notification system
        function showNotification(message, type = 'success') {
            const notification = document.createElement('div');
            notification.className = `modern-notification modern-notification-${type}`;
            notification.innerHTML = `
                <div class="modern-notification-content">
                    <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle'}"></i>
                    <span>${message}</span>
                </div>
                <button class="modern-notification-close" onclick="this.parentElement.remove()">
                    <i class="bi bi-x"></i>
                </button>
            `;
            document.body.appendChild(notification);
            
            setTimeout(() => notification.remove(), 5000);
        }

        function refreshLogs() {
            const button = event.currentTarget;
            const originalContent = button.innerHTML;
            
            button.innerHTML = '<i class="bi bi-arrow-repeat spin me-2"></i>Yenileniyor...';
            button.disabled = true;
            
            // Simulate log refresh
            setTimeout(() => {
                showNotification('Loglar başarıyla yenilendi.');
                button.innerHTML = originalContent;
                button.disabled = false;
                
                // Add a subtle animation to show refresh
                const tableBody = document.getElementById('logTableBody');
                tableBody.style.opacity = '0.5';
                setTimeout(() => {
                    tableBody.style.opacity = '1';
                }, 200);
            }, 1500);
        }

        function clearLogs() {
            if (confirm('Tüm logları temizlemek istediğinizden emin misiniz? Bu işlem geri alınamaz ve sistem güvenliği için önerilmez.')) {
                const button = event.currentTarget;
                const originalContent = button.innerHTML;
                
                button.innerHTML = '<i class="bi bi-arrow-repeat spin me-2"></i>Temizleniyor...';
                button.disabled = true;
                
                setTimeout(() => {
                    showNotification('Loglar başarıyla temizlendi.');
                    document.getElementById('logTableBody').innerHTML = 
                        '<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox me-2"></i>Log kaydı bulunamadı.</td></tr>';
                    
                    button.innerHTML = originalContent;
                    button.disabled = false;
                }, 2000);
            }
        }

        function filterLogs() {
            const level = document.getElementById('logLevel').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            
            const button = event.currentTarget;
            const originalContent = button.innerHTML;
            
            button.innerHTML = '<i class="bi bi-arrow-repeat spin"></i>';
            button.disabled = true;
            
            // Simulate filtering
            setTimeout(() => {
                let filterText = 'Loglar filtrelendi.';
                if (level) filterText += ` Seviye: ${level}.`;
                if (startDate || endDate) filterText += ' Tarih aralığı uygulandı.';
                
                showNotification(filterText);
                button.innerHTML = originalContent;
                button.disabled = false;
            }, 1000);
        }

        function showLogDetail(row) {
            // Extract data from the clicked row
            const cells = row.querySelectorAll('td');
            const time = cells[0].querySelector('.log-time').textContent.trim();
            const level = cells[1].querySelector('.modern-badge').innerHTML;
            const message = cells[2].querySelector('.log-message').textContent.trim();
            const user = cells[3].querySelector('.log-user').textContent.trim();
            const ip = cells[4].querySelector('.log-ip').textContent.trim();
            
            // Populate modal with data
            document.getElementById('logTime').textContent = time;
            document.getElementById('logLevel').innerHTML = level;
            document.getElementById('logMessage').textContent = message;
            document.getElementById('logUser').textContent = user;
            document.getElementById('logIp').textContent = ip;
            
            // Add visual feedback
            row.style.backgroundColor = 'var(--bs-primary-bg-subtle)';
            setTimeout(() => {
                row.style.backgroundColor = '';
            }, 300);
            
            // Show modal
            $('#logDetailModal').modal('show');
        }

        function exportLogDetail() {
            showNotification('Log detayı Excel dosyası olarak indiriliyor...');
            $('#logDetailModal').modal('hide');
        }

        function toggleAutoRefresh() {
            const toggle = document.getElementById('autoRefresh');
            if (toggle.checked) {
                startAutoRefresh();
                showNotification('Otomatik yenileme etkinleştirildi. Loglar 30 saniyede bir yenilenecek.', 'info');
            } else {
                stopAutoRefresh();
                showNotification('Otomatik yenileme devre dışı bırakıldı.', 'info');
            }
        }

        function startAutoRefresh() {
            if (autoRefreshInterval) clearInterval(autoRefreshInterval);
            
            autoRefreshInterval = setInterval(function() {
                // Simulate auto-refresh
                console.log('Loglar otomatik olarak yenileniyor...');
                
                // Add subtle visual indicator
                const header = document.querySelector('.detail-card-header');
                header.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
                setTimeout(() => {
                    header.style.background = '';
                }, 500);
            }, 30000);
        }

        function stopAutoRefresh() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
                autoRefreshInterval = null;
            }
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            // Setup auto-refresh toggle
            const autoRefreshToggle = document.getElementById('autoRefresh');
            if (autoRefreshToggle) {
                autoRefreshToggle.addEventListener('change', toggleAutoRefresh);
                // Start with auto-refresh enabled
                startAutoRefresh();
            }
            
            // Add hover effects to log rows
            const logRows = document.querySelectorAll('.log-row.clickable');
            logRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateX(2px)';
                    this.style.boxShadow = '0 2px 8px rgba(0,0,0,0.1)';
                });
                
                row.addEventListener('mouseleave', function() {
                    this.style.transform = '';
                    this.style.boxShadow = '';
                });
            });
            
            // Set default date filters to today
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('endDate').value = today;
            
            const weekAgo = new Date();
            weekAgo.setDate(weekAgo.getDate() - 7);
            document.getElementById('startDate').value = weekAgo.toISOString().split('T')[0];
        });

        // Cleanup on page unload
        window.addEventListener('beforeunload', function() {
            stopAutoRefresh();
        });
    </script>
}

@section Styles {
    <style>
        .log-auto-refresh {
            display: flex;
            align-items: center;
        }
        
        .filter-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr auto;
            gap: 1rem;
            align-items: end;
        }
        
        .filter-action {
            min-width: 120px;
        }
        
        .log-table .log-row.clickable {
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .log-table .log-row.clickable:hover {
            background-color: var(--bs-primary-bg-subtle);
        }
        
        .log-time, .log-user, .log-ip {
            display: flex;
            align-items: center;
            font-size: 0.9rem;
        }
        
        .log-message {
            font-weight: 500;
            line-height: 1.4;
        }
        
        .log-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .log-detail-item {
            background: var(--bs-light);
            padding: 1rem;
            border-radius: 8px;
            border-left: 4px solid var(--bs-primary);
        }
        
        .log-detail-label {
            font-weight: 600;
            color: var(--bs-primary);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
        }
        
        .log-detail-value {
            font-size: 1rem;
            color: var(--bs-dark);
        }
        
        .log-detail-section {
