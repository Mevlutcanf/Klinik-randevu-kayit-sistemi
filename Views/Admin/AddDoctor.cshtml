@model randevu_kayit.Models.ApplicationUser

@{
    ViewData["Title"] = "Yeni Doktor Ekle";
}

<link rel="stylesheet" href="~/css/admin-modern.css" />

<div class="admin-container">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="admin-card fade-in">
                    <div class="admin-card-header">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-person-plus me-3" style="font-size: 1.5rem;"></i>
                            <div>
                                <h6 class="mb-1">@ViewData["Title"]</h6>
                                <small class="opacity-75">Sisteme yeni doktor ekleyin</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="AddDoctor" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="modern-alert alert-danger mb-4" role="alert"></div>

                            <!-- Kişisel Bilgiler -->
                            <div class="mb-4">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-person me-2"></i>Kişisel Bilgiler
                                </h6>
                                <div class="row">
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="AdSoyad" class="modern-form-label">
                                            <i class="bi bi-person me-2"></i>Ad Soyad
                                        </label>
                                        <input asp-for="AdSoyad" class="modern-form-control" placeholder="Dr. Ahmet Yılmaz" />
                                        <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="Email" class="modern-form-label">
                                            <i class="bi bi-envelope me-2"></i>E-posta
                                        </label>
                                        <input asp-for="Email" class="modern-form-control" placeholder="doktor@hastane.com" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="PhoneNumber" class="modern-form-label">
                                            <i class="bi bi-telephone me-2"></i>Telefon
                                        </label>
                                        <input asp-for="PhoneNumber" class="modern-form-control" placeholder="0532 123 45 67" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 modern-form-group">
                                        <label class="modern-form-label">
                                            <i class="bi bi-image me-2"></i>Profil Fotoğrafı
                                        </label>
                                        <input type="file" name="profilePhoto" class="modern-form-control" accept="image/*" />
                                    </div>
                                </div>
                            </div>

                            <!-- Mesleki Bilgiler -->
                            <div class="mb-4">
                                <h6 class="text-success mb-3">
                                    <i class="bi bi-briefcase me-2"></i>Mesleki Bilgiler
                                </h6>
                                <div class="row">
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="DepartmentId" class="modern-form-label">
                                            <i class="bi bi-building me-2"></i>Bölüm
                                        </label>
                                        <select asp-for="DepartmentId" class="modern-form-control" asp-items="ViewBag.Departments">
                                            <option value="">Bölüm seçiniz</option>
                                        </select>
                                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="Uzmanlik" class="modern-form-label">
                                            <i class="bi bi-star me-2"></i>Uzmanlık
                                        </label>
                                        <input asp-for="Uzmanlik" class="modern-form-control" placeholder="Kardiyoloji" />
                                        <span asp-validation-for="Uzmanlik" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="CalismaSaatleri" class="modern-form-label">
                                            <i class="bi bi-clock me-2"></i>Çalışma Saatleri
                                        </label>
                                        <input asp-for="CalismaSaatleri" class="modern-form-control" placeholder="09:00 - 17:00" />
                                        <span asp-validation-for="CalismaSaatleri" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="DeneyimYili" class="modern-form-label">
                                            <i class="bi bi-award me-2"></i>Deneyim (Yıl)
                                        </label>
                                        <input asp-for="DeneyimYili" class="modern-form-control" placeholder="5" type="number" />
                                        <span asp-validation-for="DeneyimYili" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Eğitim Bilgileri -->
                            <div class="mb-4">
                                <h6 class="text-info mb-3">
                                    <i class="bi bi-mortarboard me-2"></i>Eğitim Bilgileri
                                </h6>
                                <div class="row">
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="MezunOlduguUniversite" class="modern-form-label">
                                            <i class="bi bi-bank me-2"></i>Mezun Olduğu Üniversite
                                        </label>
                                        <input asp-for="MezunOlduguUniversite" class="modern-form-control" placeholder="İstanbul Üniversitesi" />
                                        <span asp-validation-for="MezunOlduguUniversite" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 modern-form-group">
                                        <label asp-for="MezuniyetYili" class="modern-form-label">
                                            <i class="bi bi-calendar-event me-2"></i>Mezuniyet Yılı
                                        </label>
                                        <input asp-for="MezuniyetYili" class="modern-form-control" placeholder="2015" type="number" />
                                        <span asp-validation-for="MezuniyetYili" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="modern-form-group">
                                    <label asp-for="DiplomaNo" class="modern-form-label">
                                        <i class="bi bi-file-earmark-text me-2"></i>Diploma No
                                    </label>
                                    <input asp-for="DiplomaNo" class="modern-form-control" placeholder="TIP123456" />
                                    <span asp-validation-for="DiplomaNo" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Hakkında -->
                            <div class="mb-4">
                                <h6 class="text-warning mb-3">
                                    <i class="bi bi-chat-text me-2"></i>Ek Bilgiler
                                </h6>
                                <div class="modern-form-group">
                                    <label asp-for="About" class="modern-form-label">
                                        <i class="bi bi-info-circle me-2"></i>Hakkında
                                    </label>
                                    <textarea asp-for="About" class="modern-form-control" rows="4" 
                                              placeholder="Doktor hakkında kısa bilgi..."></textarea>
                                    <span asp-validation-for="About" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-3 justify-content-end">
                                <a asp-action="Doctors" class="modern-btn outline">
                                    <i class="bi bi-arrow-left me-2"></i>İptal
                                </a>
                                <button type="submit" class="modern-btn primary">
                                    <i class="bi bi-person-plus me-2"></i>Doktor Ekle
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 