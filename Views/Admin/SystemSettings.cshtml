@{
    ViewData["Title"] = "Sistem Ayarları";
}

<div class="admin-container">
    <div class="admin-header">
        <div class="admin-header-content">
            <div class="admin-header-title">
                <i class="bi bi-gear-fill"></i>
                <h1>Sistem Ayarları</h1>
                <span class="admin-header-subtitle">Uygulamanın genel ayarlarını yönetin</span>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="modern-notification modern-notification-success">
            <div class="modern-notification-content">
                <i class="bi bi-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button class="modern-notification-close" onclick="this.parentElement.remove()">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }

    <!-- Settings Form -->
    <div class="detail-card">
        <div class="detail-card-header bg-gradient-blue">
            <i class="bi bi-sliders text-white"></i>
            <h5 class="text-white mb-0">Genel Ayarlar</h5>
        </div>
        <div class="detail-card-body">
            <form asp-action="UpdateSystemSettings" method="post" class="modern-form">
                <div class="settings-grid">
                    <div class="settings-section">
                        <h6 class="settings-section-title">
                            <i class="bi bi-building me-2"></i>Site Bilgileri
                        </h6>
                        <div class="form-group">
                            <label class="form-label">Site Adı</label>
                            <input type="text" name="siteName" class="modern-input" value="Hastane Randevu Sistemi" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Site Açıklaması</label>
                            <textarea name="siteDescription" class="modern-textarea" rows="3">Modern hastane randevu yönetim sistemi</textarea>
                        </div>
                        <div class="form-group">
                            <div class="modern-toggle-wrapper">
                                <input type="checkbox" name="maintenanceMode" id="maintenanceMode" class="modern-toggle">
                                <label for="maintenanceMode" class="modern-toggle-label">
                                    <span class="modern-toggle-switch"></span>
                                    <span class="modern-toggle-text">Bakım Modu</span>
                                </label>
                            </div>
                            <small class="form-text">Bakım modu etkinken site sadece admin kullanıcılar tarafından erişilebilir</small>
                        </div>
                    </div>
                    
                    <div class="settings-section">
                        <h6 class="settings-section-title">
                            <i class="bi bi-envelope me-2"></i>İletişim Bilgileri
                        </h6>
                        <div class="form-group">
                            <label class="form-label">E-posta Adresi</label>
                            <div class="modern-input-group">
                                <i class="bi bi-envelope input-icon"></i>
                                <input type="email" class="modern-input" placeholder="sistem@hastane.com" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Telefon</label>
                            <div class="modern-input-group">
                                <i class="bi bi-telephone input-icon"></i>
                                <input type="tel" class="modern-input" placeholder="+90 212 123 45 67" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Adres</label>
                            <div class="modern-input-group">
                                <i class="bi bi-geo-alt input-icon"></i>
                                <textarea class="modern-textarea" rows="3" placeholder="Hastane adresi"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="modern-btn modern-btn-primary">
                        <i class="bi bi-check2 me-2"></i>Ayarları Kaydet
                    </button>
                    <button type="reset" class="modern-btn modern-btn-secondary">
                        <i class="bi bi-arrow-clockwise me-2"></i>Sıfırla
                    </button>
                </div>
            </form>
        </div>
    </div>    <!-- System Info Grid -->
    <div class="stats-grid">
        <div class="detail-card">
            <div class="detail-card-header bg-gradient-green">
                <i class="bi bi-info-circle text-white"></i>
                <h5 class="text-white mb-0">Sistem Bilgileri</h5>
            </div>
            <div class="detail-card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">
                            <i class="bi bi-code-square me-2"></i>Versiyon
                        </div>
                        <div class="info-value">1.0.0</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">
                            <i class="bi bi-database me-2"></i>Veritabanı
                        </div>
                        <div class="info-value">SQLite</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">
                            <i class="bi bi-calendar-check me-2"></i>Son Güncelleme
                        </div>
                        <div class="info-value">@DateTime.Now.ToString("dd.MM.yyyy")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">
                            <i class="bi bi-people me-2"></i>Aktif Kullanıcılar
                        </div>
                        <div class="info-value">
                            <span class="modern-badge modern-badge-success">Online</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="detail-card">
            <div class="detail-card-header bg-gradient-orange">
                <i class="bi bi-lightning-charge text-white"></i>
                <h5 class="text-white mb-0">Hızlı İşlemler</h5>
            </div>
            <div class="detail-card-body">
                <div class="quick-actions">
                    <button class="quick-action-btn" onclick="clearCache()">
                        <div class="quick-action-icon bg-warning">
                            <i class="bi bi-trash3"></i>
                        </div>
                        <div class="quick-action-content">
                            <div class="quick-action-title">Önbelleği Temizle</div>
                            <div class="quick-action-desc">Sistem önbelleğini temizle</div>
                        </div>
                    </button>
                    
                    <button class="quick-action-btn" onclick="testEmail()">
                        <div class="quick-action-icon bg-info">
                            <i class="bi bi-envelope-check"></i>
                        </div>
                        <div class="quick-action-content">
                            <div class="quick-action-title">E-posta Testi</div>
                            <div class="quick-action-desc">E-posta servisini test et</div>
                        </div>
                    </button>
                    
                    <button class="quick-action-btn" onclick="optimizeDb()">
                        <div class="quick-action-icon bg-success">
                            <i class="bi bi-database-gear"></i>
                        </div>
                        <div class="quick-action-content">
                            <div class="quick-action-title">DB Optimizasyonu</div>
                            <div class="quick-action-desc">Veritabanını optimize et</div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modern notification system
        function showNotification(message, type = 'success') {
            const notification = document.createElement('div');
            notification.className = `modern-notification modern-notification-${type}`;
            notification.innerHTML = `
                <div class="modern-notification-content">
                    <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle'}"></i>
                    <span>${message}</span>
                </div>
                <button class="modern-notification-close" onclick="this.parentElement.remove()">
                    <i class="bi bi-x"></i>
                </button>
            `;
            document.body.appendChild(notification);
            
            setTimeout(() => notification.remove(), 5000);
        }

        function clearCache() {
            if (confirm('Önbelleği temizlemek istediğinizden emin misiniz? Bu işlem sistem performansını geçici olarak etkileyebilir.')) {
                const button = event.currentTarget;
                const originalContent = button.innerHTML;
                
                button.innerHTML = `
                    <div class="quick-action-icon bg-warning">
                        <i class="bi bi-arrow-repeat spin"></i>
                    </div>
                    <div class="quick-action-content">
                        <div class="quick-action-title">İşlem yapılıyor...</div>
                        <div class="quick-action-desc">Önbellek temizleniyor</div>
                    </div>
                `;
                button.disabled = true;
                
                // Simulate cache clearing
                setTimeout(() => {
                    showNotification('Önbellek başarıyla temizlendi. Sistem performansı optimize edildi.');
                    button.innerHTML = originalContent;
                    button.disabled = false;
                }, 2000);
            }
        }

        function testEmail() {
            const button = event.currentTarget;
            const originalContent = button.innerHTML;
            
            button.innerHTML = `
                <div class="quick-action-icon bg-info">
                    <i class="bi bi-arrow-repeat spin"></i>
                </div>
                <div class="quick-action-content">
                    <div class="quick-action-title">Test ediliyor...</div>
                    <div class="quick-action-desc">E-posta servisi kontrol ediliyor</div>
                </div>
            `;
            button.disabled = true;
            
            // Simulate email test
            setTimeout(() => {
                showNotification('E-posta testi başarıyla tamamlandı. Servis düzgün çalışıyor.');
                button.innerHTML = originalContent;
                button.disabled = false;
            }, 3000);
        }

        function optimizeDb() {
            if (confirm('Veritabanı optimizasyonu yapılsın mı? Bu işlem birkaç dakika sürebilir.')) {
                const button = event.currentTarget;
                const originalContent = button.innerHTML;
                
                button.innerHTML = `
                    <div class="quick-action-icon bg-success">
                        <i class="bi bi-arrow-repeat spin"></i>
                    </div>
                    <div class="quick-action-content">
                        <div class="quick-action-title">Optimize ediliyor...</div>
                        <div class="quick-action-desc">Veritabanı optimize ediliyor</div>
                    </div>
                `;
                button.disabled = true;
                
                // Simulate database optimization
                setTimeout(() => {
                    showNotification('Veritabanı optimizasyonu tamamlandı. Sistem performansı artırıldı.');
                    button.innerHTML = originalContent;
                    button.disabled = false;
                }, 4000);
            }
        }

        // Form validation and enhancement
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const submitBtn = form.querySelector('button[type="submit"]');
                    const originalText = submitBtn.innerHTML;
                    
                    submitBtn.innerHTML = '<i class="bi bi-arrow-repeat spin me-2"></i>Kaydediliyor...';
                    submitBtn.disabled = true;
                    
                    // Re-enable button after form submission
                    setTimeout(() => {
                        submitBtn.innerHTML = originalText;
                        submitBtn.disabled = false;
                    }, 2000);
                });
            }
            
            // Auto-hide success notifications
            const notifications = document.querySelectorAll('.modern-notification-success');
            notifications.forEach(notification => {
                setTimeout(() => {
                    notification.style.transform = 'translateX(100%)';
                    setTimeout(() => notification.remove(), 300);
                }, 3000);
            });
        });
    </script>
}
