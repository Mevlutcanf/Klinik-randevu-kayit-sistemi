@using Microsoft.AspNetCore.Identity

<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Authenticated User Dropdown -->
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar me-2">
                <i class="bi bi-person-circle fs-5"></i>
            </div>
            <span class="d-none d-md-inline">@User.Identity.Name</span>
        </a>
        <div class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 250px;">
            <div class="dropdown-header bg-light">
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-circle fs-4 me-2 text-primary"></i>
                    <div>
                        <div class="fw-bold">@User.Identity.Name</div>
                        <small class="text-muted">
                            @if (User.IsInRole("Admin")) { <span class="badge bg-danger">Admin</span> }
                            @if (User.IsInRole("Doctor")) { <span class="badge bg-success">Doktor</span> }
                            @if (User.IsInRole("Patient")) { <span class="badge bg-primary">Hasta</span> }
                        </small>
                    </div>
                </div>
            </div>
            
            @if (User.IsInRole("Patient"))
            {
                <a class="dropdown-item py-2" asp-controller="Randevu" asp-action="Index">
                    <i class="bi bi-calendar-check me-2 text-primary"></i>Randevularım
                </a>
                <a class="dropdown-item py-2" asp-controller="QuickAppointment" asp-action="Create">
                    <i class="bi bi-lightning me-2 text-warning"></i>Hızlı Randevu
                </a>
            }
            @if (User.IsInRole("Doctor"))
            {
                <a class="dropdown-item py-2" asp-controller="Doctor" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2 text-info"></i>Doktor Paneli
                </a>
                <a class="dropdown-item py-2" asp-controller="Doctor" asp-action="Appointments">
                    <i class="bi bi-clipboard2-pulse me-2 text-success"></i>Hasta Randevuları
                </a>
                <a class="dropdown-item py-2" asp-controller="Doctor" asp-action="Schedule">
                    <i class="bi bi-calendar-week me-2 text-primary"></i>Çalışma Programı
                </a>
            }            @if (User.IsInRole("Admin"))
            {
                <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2 text-danger"></i>Admin Paneli
                </a>
                <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users">
                    <i class="bi bi-people me-2 text-info"></i>Kullanıcı Yönetimi
                </a>
                <a class="dropdown-item py-2" asp-controller="Admin" asp-action="UserManagement">
                    <i class="bi bi-person-gear me-2 text-primary"></i>Gelişmiş Kullanıcı Yönetimi
                </a>
                <a class="dropdown-item py-2" asp-controller="Admin" asp-action="SystemSettings">
                    <i class="bi bi-gear me-2 text-warning"></i>Sistem Ayarları
                </a>
                <a class="dropdown-item py-2" asp-controller="Admin" asp-action="SystemLogs">
                    <i class="bi bi-journal-text me-2 text-success"></i>Sistem Logları
                </a>
                <a class="dropdown-item py-2" asp-controller="Admin" asp-action="BackupRestore">
                    <i class="bi bi-archive me-2 text-secondary"></i>Yedekleme & Geri Yükleme
                </a>
            }
            
            <div class="dropdown-divider"></div>
            <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                <i class="bi bi-person me-2 text-secondary"></i>Profil Ayarları
            </a>
            
            <div class="dropdown-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                <button type="submit" class="dropdown-item py-2 text-danger">
                    <i class="bi bi-box-arrow-right me-2"></i>Güvenli Çıkış
                </button>
            </form>
        </div>
    </li>
}
else
{
    <!-- Guest User Actions -->
    <li class="nav-item me-2">
        <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
        </a>
    </li>
    <li class="nav-item me-2">
        <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i>Kayıt Ol
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="QuickAppointment" asp-action="Create">
            <i class="bi bi-lightning me-1"></i>Hızlı Randevu
        </a>
    </li>
}
</ul>
