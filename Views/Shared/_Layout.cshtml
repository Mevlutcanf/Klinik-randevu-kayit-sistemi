<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sincan Özel Tıp Merkezi</title>
    <meta name="description" content="Ankara Sincan'da kaliteli sağlık hizmeti. Uzman doktorlar, modern tıbbi cihazlar ve online randevu sistemi ile 7/24 hizmetinizdeyiz.">
    <meta name="keywords" content="hastane, doktor, randevu, sağlık, tıp merkezi, sincan, ankara">
    <meta name="author" content="Sincan Özel Tıp Merkezi">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="@ViewData["Title"] - Sincan Özel Tıp Merkezi">
    <meta property="og:description" content="Ankara Sincan'da kaliteli sağlık hizmeti">
    <meta property="og:type" content="website">
    <meta property="og:url" content="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    
    <!-- Preload critical resources -->
    <link rel="preload" href="~/css/site.css" as="style">
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" as="style">
    
    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    
    <!-- Progressive Web App -->
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#2c7be5">
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Loading Spinner -->
    <div id="loading-spinner" class="loading-spinner" style="display: none;"></div>

    <!-- Toast Container -->
    <div class="toast-container"></div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3 fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon me-2">
                        <i class="bi bi-hospital text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <div class="brand-text">
                        <span class="fw-bold text-primary">Sincan</span>
                        <span class="text-secondary">Özel Tıp Merkezi</span>
                    </div>
                </a>
                
                <!-- Search Bar (visible on larger screens) -->
                <div class="search-container d-none d-lg-flex mx-auto" style="max-width: 400px;">
                    <div class="input-group">
                        <input type="text" class="form-control border-0 bg-light" placeholder="Doktor, bölüm veya hizmet ara..." id="navbar-search">
                        <button class="btn btn-outline-secondary border-0 bg-light" type="button">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-end">
                    <ul class="navbar-nav me-auto me-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Ana Sayfa
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid me-1"></i>Hizmetlerimiz
                            </a>
                            <ul class="dropdown-menu border-0 shadow-lg">
                                <li><a class="dropdown-item" asp-controller="Department" asp-action="Index">
                                    <i class="bi bi-hospital me-2"></i>Bölümlerimiz
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Doctor" asp-action="List">
                                    <i class="bi bi-people me-2"></i>Doktorlarımız
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="QuickAppointment" asp-action="Create">
                                    <i class="bi bi-lightning me-2"></i>Hızlı Randevu
                                </a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#hakkimizda">
                                <i class="bi bi-info-circle me-1"></i>Hakkımızda
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#iletisim">
                                <i class="bi bi-telephone me-1"></i>İletişim
                            </a>
                        </li>
                    </ul>
                    
                    <!-- Login Partial Only -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-3" style="margin-top: 80px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer bg-dark text-light mt-auto">
        <div class="container">
            <!-- Main Footer Content -->
            <div class="row py-5">
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="footer-brand mb-4">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-hospital text-primary me-2" style="font-size: 2rem;"></i>
                            <div>
                                <h5 class="text-white mb-0">Sincan</h5>
                                <small class="text-light">Özel Tıp Merkezi</small>
                            </div>
                        </div>
                        <p class="text-light mb-3">
                            Sağlığınız bizim önceliğimiz. Modern tıp anlayışı ve uzman kadromuzla 
                            1995'ten bu yana hizmetinizdeyiz.
                        </p>
                        <div class="social-links">
                            <a href="#" class="text-light me-3" title="Facebook">
                                <i class="bi bi-facebook" style="font-size: 1.5rem;"></i>
                            </a>
                            <a href="#" class="text-light me-3" title="Instagram">
                                <i class="bi bi-instagram" style="font-size: 1.5rem;"></i>
                            </a>
                            <a href="#" class="text-light me-3" title="Twitter">
                                <i class="bi bi-twitter" style="font-size: 1.5rem;"></i>
                            </a>
                            <a href="#" class="text-light" title="LinkedIn">
                                <i class="bi bi-linkedin" style="font-size: 1.5rem;"></i>
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="text-white mb-3">Hızlı Linkler</h6>
                    <ul class="list-unstyled footer-links">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Index" class="text-light text-decoration-none">
                                <i class="bi bi-chevron-right me-2"></i>Ana Sayfa
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Department" asp-action="Index" class="text-light text-decoration-none">
                                <i class="bi bi-chevron-right me-2"></i>Bölümlerimiz
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Doctor" asp-action="List" class="text-light text-decoration-none">
                                <i class="bi bi-chevron-right me-2"></i>Doktorlarımız
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#hakkimizda" class="text-light text-decoration-none">
                                <i class="bi bi-chevron-right me-2"></i>Hakkımızda
                            </a>
                        </li>
                        @if (!User.Identity?.IsAuthenticated ?? true)
                        {
                            <li class="mb-2">
                                <a asp-controller="QuickAppointment" asp-action="Create" class="text-light text-decoration-none">
                                    <i class="bi bi-chevron-right me-2"></i>Hızlı Randevu
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-4">
                    <h6 class="text-white mb-3">İletişim Bilgileri</h6>
                    <div class="contact-info">
                        <div class="d-flex mb-3">
                            <i class="bi bi-geo-alt-fill text-primary me-3 mt-1"></i>
                            <div>
                                <strong class="text-white">Adres:</strong><br>
                                <span class="text-light">Ankara/Sincan</span>
                            </div>
                        </div>
                        <div class="d-flex mb-3">
                            <i class="bi bi-telephone-fill text-primary me-3 mt-1"></i>
                            <div>
                                <strong class="text-white">Telefon:</strong><br>
                                <a href="tel:+905367151292" class="text-light text-decoration-none">0536 715 12 92</a>
                            </div>
                        </div>
                        <div class="d-flex mb-3">
                            <i class="bi bi-envelope-fill text-primary me-3 mt-1"></i>
                            <div>
                                <strong class="text-white">E-posta:</strong><br>
                                <a href="mailto:mevlut201mevlut@gmail.com" class="text-light text-decoration-none">mevlut201mevlut@gmail.com</a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-4">
                    <h6 class="text-white mb-3">Çalışma Saatleri & Acil Durum</h6>
                    <div class="working-hours mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-light">Pazartesi - Cuma:</span>
                            <span class="text-white">09:00 - 18:00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-light">Cumartesi:</span>
                            <span class="text-white">09:00 - 13:00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-light">Pazar:</span>
                            <span class="text-danger">Kapalı</span>
                        </div>
                    </div>
                    
                    <!-- Emergency Contact - Fixed Position -->
                    <div class="emergency-contact-fixed">
                        <div class="emergency-contact p-3 bg-danger rounded text-center">
                            <i class="bi bi-exclamation-triangle-fill mb-2 text-white" style="font-size: 1.5rem;"></i>
                            <h6 class="text-white mb-1">ACİL DURUM</h6>
                            <div class="d-flex justify-content-center gap-3">
                                <a href="tel:112" class="btn btn-light btn-sm fw-bold">
                                    <i class="bi bi-telephone-fill me-1"></i>112
                                </a>
                                <a href="tel:+905367151292" class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-hospital me-1"></i>Hastane
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Footer Bottom -->
            <div class="border-top border-secondary py-3">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p class="mb-0 text-light">
                            <i class="bi bi-c-circle me-1"></i>@DateTime.Now.Year Sincan Özel Tıp Merkezi. Tüm hakları saklıdır.
                        </p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="footer-legal">
                            <a href="#" class="text-light text-decoration-none me-3">Gizlilik Politikası</a>
                            <a href="#" class="text-light text-decoration-none me-3">Kullanım Şartları</a>
                            <a href="#" class="text-light text-decoration-none">KVKK</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Back to Top Button -->
        <button class="back-to-top btn btn-primary rounded-circle shadow position-fixed" 
                onclick="scrollToTop()" 
                style="bottom: 20px; right: 20px; width: 50px; height: 50px; z-index: 1050; opacity: 0; visibility: hidden; transition: all 0.3s ease;">
            <i class="bi bi-arrow-up"></i>
        </button>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global Scripts -->
    <script>
        // Back to top button functionality
        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        // Show/hide back to top button based on scroll
        window.addEventListener('scroll', function() {
            const backToTopBtn = document.querySelector('.back-to-top');
            if (backToTopBtn) {
                if (window.pageYOffset > 300) {
                    backToTopBtn.style.opacity = '1';
                    backToTopBtn.style.visibility = 'visible';
                } else {
                    backToTopBtn.style.opacity = '0';
                    backToTopBtn.style.visibility = 'hidden';
                }
            }
        });

        // Loading spinner management
        $(document).on('submit', 'form', function() {
            $('#loading-spinner').show();
        });

        $(window).on('load', function() {
            $('#loading-spinner').hide();
        });

        // Toast notification function
        function showToast(message, type = 'success') {
            const toast = `
                <div class="toast align-items-center text-white bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            $('.toast-container').append(toast);
            const toastElement = $('.toast').last();
            const bsToast = new bootstrap.Toast(toastElement[0]);
            bsToast.show();
            
            setTimeout(() => {
                toastElement.remove();
            }, 5000);
        }

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    const headerOffset = 100;
                    const elementPosition = target.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            });
        });

        // Active link highlighting
        $(document).ready(function() {
            const currentPath = window.location.pathname;
            $('.navbar-nav .nav-link').each(function() {
                const href = $(this).attr('href');
                if (href && href !== '#' && currentPath.includes(href)) {
                    $(this).addClass('active');
                }
            });

            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Initialize popovers
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl);
            });
        });

        // Navbar search functionality
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('navbar-search');
            if (searchInput) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const query = this.value.trim();
                        if (query) {
                            // Redirect to search page or handle search
                            window.location.href = `/Home/Search?q=${encodeURIComponent(query)}`;
                        }
                    }
                });
            }
        });

        // Auto-dismiss alerts after 5 seconds
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });

        // Form validation enhancement
        $(document).ready(function() {
            $('.needs-validation').on('submit', function(e) {
                if (this.checkValidity() === false) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(this).addClass('was-validated');
            });
        });

        // Image lazy loading fallback
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('img');
            images.forEach(img => {
                img.addEventListener('error', function() {
                    this.src = '/images/placeholder.jpg'; // Fallback image
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
