@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-5">
                <h1 class="display-4 mb-3">Ankara Sincan Devlet Hastanesi</h1>
                <p class="lead text-muted">Sağlığınız İçin Yanınızdayız</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-4">
                                <i class="bi bi-heart-pulse-fill text-primary me-3" style="font-size: 2.5rem;"></i>
                                <h3 class="card-title mb-0">Misyonumuz</h3>
                            </div>
                            <p class="card-text">
                                Hasta odaklı yaklaşım, kaliteli sağlık hizmeti ve modern tıbbi teknoloji ile 
                                toplumun sağlık ihtiyaçlarını en üst düzeyde karşılamak, sürdürülebilir ve 
                                erişilebilir sağlık hizmeti sunmak.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-4">
                                <i class="bi bi-eye-fill text-primary me-3" style="font-size: 2.5rem;"></i>
                                <h3 class="card-title mb-0">Vizyonumuz</h3>
                            </div>
                            <p class="card-text">
                                Sağlık hizmetlerinde öncü, yenilikçi yaklaşımlarla örnek gösterilen, 
                                hasta ve çalışan memnuniyetini en üst düzeyde tutan, 
                                bölgemizin güvenilir sağlık merkezi olmak.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-4">
                                <i class="bi bi-stars text-primary me-3" style="font-size: 2.5rem;"></i>
                                <h3 class="card-title mb-0">Değerlerimiz</h3>
                            </div>
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        <h5 class="mb-0">Hasta Odaklılık</h5>
                                    </div>
                                    <p class="text-muted small">Hastalarımızın ihtiyaç ve beklentilerini önceliklendiriyoruz.</p>
                                </div>
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        <h5 class="mb-0">Profesyonellik</h5>
                                    </div>
                                    <p class="text-muted small">En yüksek standartlarda sağlık hizmeti sunuyoruz.</p>
                                </div>
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                        <h5 class="mb-0">Yenilikçilik</h5>
                                    </div>
                                    <p class="text-muted small">Modern tıbbi teknoloji ve yaklaşımları takip ediyoruz.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-5">
                <h3 class="mb-4">Rakamlarla Hastanemiz</h3>
                <div class="row g-4">
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-people-fill text-primary mb-3" style="font-size: 2rem;"></i>
                                <h2 class="mb-0">50+</h2>
                                <p class="text-muted small mb-0">Uzman Doktor</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-building-fill text-primary mb-3" style="font-size: 2rem;"></i>
                                <h2 class="mb-0">15+</h2>
                                <p class="text-muted small mb-0">Branş</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-heart-fill text-primary mb-3" style="font-size: 2rem;"></i>
                                <h2 class="mb-0">1000+</h2>
                                <p class="text-muted small mb-0">Günlük Hasta</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <i class="bi bi-calendar-check-fill text-primary mb-3" style="font-size: 2rem;"></i>
                                <h2 class="mb-0">24/7</h2>
                                <p class="text-muted small mb-0">Hizmet</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/about-modern.css" />
}