@{
    ViewData["Title"] = "İletişim";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <h2 class="mb-4">Bize Ulaşın</h2>
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-geo-alt-fill text-primary me-3" style="font-size: 2rem;"></i>
                        <div>
                            <h5 class="mb-1">Adres</h5>
                            <p class="mb-0">Ankara Sincan Devlet Hastanesi<br>
                            Andiçen Mahallesi, Polatlı 2 Caddesi No:40<br>
                            06930 Sincan/Ankara</p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-telephone-fill text-primary me-3" style="font-size: 2rem;"></i>
                        <div>
                            <h5 class="mb-1">Telefon</h5>
                            <p class="mb-0">
                                <a href="tel:+903122701790" class="text-decoration-none">0312 270 17 90</a><br>
                                <a href="tel:+905367151292" class="text-decoration-none">0536 715 12 92</a>
                            </p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-envelope-fill text-primary me-3" style="font-size: 2rem;"></i>
                        <div>
                            <h5 class="mb-1">E-posta</h5>
                            <p class="mb-0">
                                <a href="mailto:sincandevlethastanesi@saglik.gov.tr" class="text-decoration-none">
                                    sincandevlethastanesi@saglik.gov.tr
                                </a><br>
                                <a href="mailto:mevlut201mevlut@gmail.com" class="text-decoration-none">
                                    mevlut201mevlut@gmail.com
                                </a>
                            </p>
                        </div>
                    </div>

                    <!-- Working Hours -->
                    <div class="working-hours">
                        <h6><i class="bi bi-clock me-2"></i>Çalışma Saatleri</h6>
                        <div class="row mb-2">
                            <div class="col-6">Pazartesi - Cuma:</div>
                            <div class="col-6">08:00 - 17:00</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-6">Cumartesi:</div>
                            <div class="col-6">08:00 - 12:00</div>
                        </div>
                        <div class="row">
                            <div class="col-6">Pazar:</div>
                            <div class="col-6">Kapalı</div>
                        </div>
                    </div>

                    <!-- Emergency Contact -->
                    <div class="emergency-contact">
                        <h6><i class="bi bi-exclamation-triangle me-2"></i>Acil Durum</h6>
                        <p>112 - Acil Çağrı Merkezi</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <h2 class="mb-4">Konum</h2>
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="ratio ratio-4x3">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3060.5476967456997!2d32.5574445!3d39.9076083!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14d3485e9c9cd8f9%3A0x4f5a09e3eb849e21!2sAnkara%20Sincan%20Devlet%20Hastanesi!5e0!3m2!1str!2str!4v1647887654321!5m2!1str!2str"
                                style="border:0;" allowfullscreen="" loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>

            <!-- Quick Contact Actions -->
            <div class="mt-4 text-center">
                <div class="social-links">
                    <a href="tel:+903122701790" title="Telefon">
                        <i class="bi bi-telephone"></i>
                    </a>
                    <a href="mailto:mevlut201mevlut@gmail.com" title="E-posta">
                        <i class="bi bi-envelope"></i>
                    </a>
                    <a href="https://goo.gl/maps/example" target="_blank" title="Yol Tarifi">
                        <i class="bi bi-geo-alt"></i>
                    </a>
                    <a href="#" title="WhatsApp">
                        <i class="bi bi-whatsapp"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/contact-modern.css" />
}