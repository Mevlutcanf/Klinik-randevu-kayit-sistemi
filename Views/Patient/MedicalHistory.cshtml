@using randevu_kayit.Models
@model IEnumerable<MedicalHistory>

@{
    ViewData["Title"] = "Tıbbi Geçmişim";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">
                <i class="bi bi-journal-medical me-2"></i>
                Tıbbi Geçmişim
            </h2>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Henüz kayıtlı bir muayene geçmişiniz bulunmamaktadır.
                </div>
            }
            else
            {
                <div class="timeline">
                    @foreach (var history in Model)
                    {
                        <div class="timeline-item">
                            <div class="card shadow-sm">
                                <div class="card-header bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <i class="bi bi-calendar-event me-2"></i>
                                            @history.TarihSaat.ToString("dd.MM.yyyy HH:mm")
                                        </h5>
                                        <span class="text-muted">
                                            <i class="bi bi-person-badge me-1"></i>
                                            Dr. @history.Doktor.AdSoyad
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <h6><i class="bi bi-clipboard2-pulse me-2"></i>Tanı</h6>
                                            <p>@history.Tani</p>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(history.Tedavi))
                                    {
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-bandaid me-2"></i>Tedavi</h6>
                                                <p>@history.Tedavi</p>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(history.YazilanIlaclar))
                                    {
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-capsule me-2"></i>Yazılan İlaçlar</h6>
                                                <p>@history.YazilanIlaclar</p>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(history.LabSonuclari))
                                    {
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-file-earmark-medical me-2"></i>Laboratuvar Sonuçları</h6>
                                                <p>@history.LabSonuclari</p>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(history.Notlar))
                                    {
                                        <div class="row">
                                            <div class="col-md-12">
                                                <h6><i class="bi bi-journal-text me-2"></i>Notlar</h6>
                                                <p>@history.Notlar</p>
                                            </div>
                                        </div>
                                    }

                                    @if (history.SonrakiRandevuTarihi.HasValue)
                                    {
                                        <div class="alert alert-info mt-3 mb-0">
                                            <i class="bi bi-calendar-check me-2"></i>
                                            <strong>Sonraki Randevu:</strong> @history.SonrakiRandevuTarihi.Value.ToString("dd.MM.yyyy")
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div> 